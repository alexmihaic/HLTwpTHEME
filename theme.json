{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "900px",
      "wideSize": "1600px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "base-black",
          "name": "Negro base",
          "color": "#080808"
        },
        {
          "slug": "secondary-black",
          "name": "Negro secundario",
          "color": "#111111"
        },
        {
          "slug": "clean-white",
          "name": "Blanco limpio",
          "color": "#F2F2F2"
        },
        {
          "slug": "soft-gray",
          "name": "Gris texto",
          "color": "#A6A6A6"
        },
        {
          "slug": "hlt-red",
          "name": "Rojo HLT",
          "color": "#E10600"
        }
      ]
    },
    "typography": {
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "name": "Inter System",
          "slug": "inter-system"
        },
        {
          "fontFamily": "\"Archivo Narrow\", \"Arial Narrow\", Arial, sans-serif",
          "name": "Archivo Narrow System",
          "slug": "archivo-narrow-system"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.875rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "1rem",
          "name": "S"
        },
        {
          "slug": "md",
          "size": "1.125rem",
          "name": "M"
        },
        {
          "slug": "lg",
          "size": "1.5rem",
          "name": "L"
        },
        {
          "slug": "xl",
          "size": "2.25rem",
          "name": "XL"
        },
        {
          "slug": "xxl",
          "size": "clamp(2.75rem, 7vw, 5rem)",
          "name": "XXL"
        }
      ],
      "lineHeight": true
    },
    "spacing": {
      "blockGap": "1.5rem",
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "2XS"
        },
        {
          "slug": "30",
          "size": "1rem",
          "name": "XS"
        },
        {
          "slug": "40",
          "size": "1.5rem",
          "name": "S"
        },
        {
          "slug": "50",
          "size": "2.5rem",
          "name": "M"
        },
        {
          "slug": "60",
          "size": "4rem",
          "name": "L"
        },
        {
          "slug": "70",
          "size": "6rem",
          "name": "XL"
        }
      ],
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base-black)",
      "text": "var(--wp--preset--color--clean-white)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter-system)",
      "fontSize": "var(--wp--preset--font-size--sm)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo-narrow-system)",
          "fontWeight": "700",
          "lineHeight": "1.08",
          "letterSpacing": "-0.01em"
        },
        "color": {
          "text": "var(--wp--preset--color--clean-white)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--clean-white)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--hlt-red)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var(--wp--preset--color--hlt-red)",
          "text": "var(--wp--preset--color--clean-white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo-narrow-system)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "700",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.35rem",
            "right": "1.35rem"
          }
        }
      }
    },
    "blocks": {
      "core/group": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--70)",
            "bottom": "var(--wp--preset--spacing--70)"
          }
        }
      },
      "core/paragraph": {
        "color": {
          "text": "var(--wp--preset--color--soft-gray)"
        }
      }
    }
  }
}